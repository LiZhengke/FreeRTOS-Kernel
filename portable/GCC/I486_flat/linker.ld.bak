/* linker_high.ld - i486 higher-half kernel with paging */

OUTPUT_FORMAT(elf32-i386)
ENTRY(_start)

KERNEL_VMA = 0xC0000000;   /* Virtual address base */
KERNEL_LMA = 0x00100000;   /* Physical load address */

/* -------------------- */
/* Linker section definitions */
/* -------------------- */
SECTIONS
{
    /* ========================================
     * Boot code — runs at PHYSICAL addresses
     * before paging is enabled.
     * ======================================== */
    . = KERNEL_LMA;

    .boot ALIGN(4K) : AT(KERNEL_LMA)
    {
        KEEP(*(.multiboot))
        *(.boot*)
    }

    /* ========================================
     * From here on, everything has VMA in the
     * higher half (0xC0000000+).
     * ======================================== */
    . += KERNEL_VMA;

    /* -------------------- */
    /* Code + read-only data */
    /* -------------------- */
    .text ALIGN(4K) : AT(ADDR(.text) - KERNEL_VMA)
    {
        *(.text*)                /* All code */
        *(.rodata*)              /* Constant data */
        *(.eh_frame)
    }

    /* -------------------- */
    /* Initialized data     */
    /* -------------------- */
    .data ALIGN(4K) : AT(ADDR(.data) - KERNEL_VMA)
    {
        __data_start = .;
        *(.data*)
        __data_end = .;
    }

    /* -------------------- */
    /* BSS                  */
    /* -------------------- */
    .bss ALIGN(4K) : AT(ADDR(.bss) - KERNEL_VMA)
    {
        __bss_start = .;
        *(.bss*)
        *(COMMON)
        __bss_end = .;
    }

    _kernel_phys_end = . - KERNEL_VMA;
    _user_code_phys_start = _kernel_phys_end; /* Record the physical start address of the user code section. */
    /* ==========================================================
     * 3. User section templates (User Section Templates)
     * These are placed physically at the end of the kernel image,
     * while the compiler treats them as located at 0x08048000.
     * ========================================================== */

    /* Define the runtime start address for user code section. */
    . = 0x08048000;

    .user_text ALIGN(4K) : AT(_kernel_phys_end)
    {
        _user_text_vma_start = .;
        *(.user_text)  /* Store all user functions and exit wrappers. */
        _user_text_vma_end = .;
    }

    /* Update physical pointer to follow the user_text physical region. */
    _user_data_phys_template = _kernel_phys_end + SIZEOF(.user_text);

    . = ALIGN(4K); /* Keep data section page-aligned for independent mapping. */
    .user_data ALIGN(4K) : AT(_user_data_phys_template)
    {
        _user_data_vma_start = .;
        *(.user_data)
        *(.user_rodata)
        _user_data_vma_end = .;
    }

    . = ALIGN(4K); /* Keep stack section page-aligned for independent mapping. */
    .user_stack ALIGN(4K) : AT(_user_data_phys_template + SIZEOF(.user_data))
    {
        _user_stack_vma_start = .;
        *(.user_stack)
        _user_stack_vma_end = .;
    }
    /* Record the final physical end after all user templates. */
    _user_templates_phys_end = _user_data_phys_template + SIZEOF(.user_data) + SIZEOF(.user_stack);

    /* ==========================================================
     * 4. Return to kernel space: define heap and stack.
     * ========================================================== */
    . = KERNEL_VMA + _user_templates_phys_end;
    . = ALIGN(4K);
    /* -------------------- */
    /* Heap for FreeRTOS    */
    /* -------------------- */
    __heap_start = .;
    .heap : AT(ADDR(.heap) - KERNEL_VMA)
    {
        *(.heap)
    }
    . += 64K;
    __heap_end = .;

    /* -------------------- */
    /* Stack (top-down)     */
    /* -------------------- */
    . = ALIGN(16);
    __stack_bottom = .;
    . += 64K;
    __stack_top = .;

    /* Physical addresses for boot code */
    __phys_start = KERNEL_LMA;
    __phys_end   = _user_templates_phys_end;
    _kernel_end = .;
}
